{
  // Pins every Python feature in this workspace to the project's own .venv, so
  // VS Code never falls back to the Homebrew system Python (3.14, which has no
  // xgboost wheel).
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // Auto-activate .venv in new integrated terminals, so `python`, `pip`,
  // `uvicorn` and `streamlit` resolve to the project versions without needing
  // `source .venv/bin/activate` every time.
  "python.terminal.activateEnvironment": true,

  // Notebook kernels run with their own directory as the working directory,
  // which is what the "../data/..." paths in notebooks/ assume.
  "jupyter.notebookFileRoot": "${fileDirname}",

  "files.exclude": {
    "**/__pycache__": true,
    "**/.ipynb_checkpoints": true
  }
}
